import orbalion.*

describe "Tests de Orbalion" {
  //Checkpoint 1
  test "Un entrenador no puede tener un rol distinto a los autorizados por la FOZ" {
    const unEntrenador = new Entrenador()
    assert.throwsException({ unEntrenador.cambiar("Piloto Galactico") })
  }

  test "Un equipo luminico con radiacion mayor a 5000 y sin tecnologias activas su energia total es su energia base" {
    const unEntrenador = new Entrenador()
    const equipoLum = new Luminico(nombre = "Rayos", nivelDeEnergiaBase = 1000, entrenador = unEntrenador, nivelDeRadiacionCapturado = 6000)
    assert.equals(1000, equipoLum.energiaTotal())
  }

  test "Un equipo luminico con radiacion menor a 5000 obtiene el bono del 10 por ciento" {
    const unEntrenador = new Entrenador()
    const equipoLum = new Luminico(nombre = "Fotones", nivelDeEnergiaBase = 1000, entrenador = unEntrenador, nivelDeRadiacionCapturado = 4000)
    assert.equals(1100, equipoLum.energiaTotal())
  }

  test "Un equipo sintetico con 6 modulos aplica correctamente la penalizacion del 20 por ciento" {
    const unEntrenador = new Entrenador()
    const equipoSin = new Sintetico(nombre = "Robots", nivelDeEnergiaBase = 1000, entrenador = unEntrenador, cantidadDeModulosActivos = 6)
    assert.equals(800, equipoSin.energiaTotal())
  }

  test "Un equipo sintetico con 4 modulos y 2 tecnologias complementarias suma correctamente los valores energeticos" {
    const unEntrenador = new Entrenador()
    const tec1 = new TecnologiaComplementaria(nombre = "Nucleo", valorEnergetico = 200, activo = true)
    const tec2 = new TecnologiaComplementaria(nombre = "Interfaz", valorEnergetico = 300, activo = true)
    
    const equipoSin = new Sintetico(nombre = "Ciberneticos", nivelDeEnergiaBase = 1000, entrenador = unEntrenador, cantidadDeModulosActivos = 4, listaDeTecnologiasComplementarias = [tec1, tec2])
    
    assert.equals(1500, equipoSin.energiaTotal())
  }
  
  
  //Checkpoint 2

  test "Estratega cuantico con 12 ciclos y precision 90 es de elite galactica" {
    const unEntrenador = new Entrenador(cantidadDeCiclosSolaresDeExperiencia = 12, nivelDePresicionEstrategica = 90)
    assert.that(unEntrenador.esDeEliteGalactica())
  }

  test "Arquitecto de energia con 11 ciclos pero sin sintonia no es de elite" {
    const unEntrenador = new Entrenador(cantidadDeCiclosSolaresDeExperiencia = 11, rol = "Arquitecto de Energia")
    assert.notThat(unEntrenador.esDeEliteGalactica())
  }

  test "Guia mental con 15 ciclos siempre es de elite" {
    const unEntrenador = new Entrenador(cantidadDeCiclosSolaresDeExperiencia = 15, rol = "Guia Mental")
    assert.that(unEntrenador.esDeEliteGalactica())
  }


  //Checkpoint 3

  test "Equipo luminico con 3 cristales, entrenador de elite y una tecnologia activa es de prestigio universal" {
    const unEntrenador = new Entrenador(cantidadDeCiclosSolaresDeExperiencia = 12, nivelDePresicionEstrategica = 90, rol = "Estratega Cuantico")
    const unaTecnologia = new TecnologiaComplementaria(nombre = "Modulador", valorEnergetico = 100, activo = true)
    const unEquipoLuminico = new Luminico(nombre = "Luminus", entrenador = unEntrenador, nivelDeRadiacionCapturado = 4000, listaDeCristalesSolares = [1, 2, 3], listaDeTecnologiasComplementarias = [unaTecnologia])

    assert.that(unEquipoLuminico.esDePrestigioUniversal())
  }

  test "Equipo sintetico certificado con 4 modulos y todas las tecnologias activas es de prestigio" {
    const unaTecnologia = new TecnologiaComplementaria(nombre = "Procesador", valorEnergetico = 150, activo = true)
    const unEquipoSintetico = new Sintetico(nombre = "CyberCore", entrenador = new Entrenador(), cantidadDeModulosActivos = 4,
      unidadEstable = true,
      listaDeTecnologiasComplementarias = [unaTecnologia]
    )

    assert.that(unEquipoSintetico.esDePrestigioUniversal())
  }

  test "Equipo luminico con menos de 3 cristales no es de prestigio universal" {
    const unEntrenador = new Entrenador(cantidadDeCiclosSolaresDeExperiencia = 12, nivelDePresicionEstrategica = 90)
    const unaTecnologia = new TecnologiaComplementaria(nombre = "Modulador", activo = true)
    const unEquipoLuminico = new Luminico(nombre = "Luminus Incompleto", entrenador = unEntrenador, listaDeCristalesSolares = [1, 2], listaDeTecnologiasComplementarias = [unaTecnologia])

    assert.notThat(unEquipoLuminico.esDePrestigioUniversal())
  }

  test "Equipo sintetico no estable o con modulos insuficientes no es de prestigio" {
    const unEquipoSintetico = new Sintetico(nombre = "CyberInestable", entrenador = new Entrenador(), cantidadDeModulosActivos = 2, unidadEstable = false)

    assert.notThat(unEquipoSintetico.esDePrestigioUniversal())
  }


  //Checkpoint 4

  test "Equipo eterico con condiciones cumplidas es de prestigio universal" {
    const tec1 = new TecnologiaComplementaria(nombre = "PortalNet", valorEnergetico = 100, activo = true)
    const tec2 = new TecnologiaComplementaria(nombre = "Sintonizador", valorEnergetico = 50, activo = true)
    
    const equipoEterico = new Eterico(nombre = "Eternity", entrenador = new Entrenador(), nivelDeFluctuacionDimensional = 80, cantidadDePortalesEnergicosAbiertos = 3, listaDeTecnologiasComplementarias = [tec1, tec2])

    assert.that(equipoEterico.esDePrestigioUniversal())
  }

  test "Verificar que el incremento del 15 por ciento se aplica correctamente cuando es de prestigio" {
    const tec1 = new TecnologiaComplementaria(nombre = "A", valorEnergetico = 200, activo = true)
    const tec2 = new TecnologiaComplementaria(nombre = "B", valorEnergetico = 200, activo = true)
    
    const equipoEterico = new Eterico(nombre = "EterPlus", nivelDeEnergiaBase = 1000, entrenador = new Entrenador(), nivelDeFluctuacionDimensional = 80, cantidadDePortalesEnergicosAbiertos = 3, listaDeTecnologiasComplementarias = [tec1, tec2])

    assert.equals(1610, equipoEterico.energiaTotal())
  }

  test "Verificar que un equipo eterico que no cumple las condiciones no suma el incremento del 15 por ciento" {
    const tec1 = new TecnologiaComplementaria(nombre = "A", valorEnergetico = 200, activo = true)
    
    const equipoEtericoIncompleto = new Eterico(nombre = "EterNormal", nivelDeEnergiaBase = 1000, entrenador = new Entrenador(), nivelDeFluctuacionDimensional = 60, cantidadDePortalesEnergicosAbiertos = 1, listaDeTecnologiasComplementarias = [tec1])

    assert.notThat(equipoEtericoIncompleto.esDePrestigioUniversal())
    assert.equals(1200, equipoEtericoIncompleto.energiaTotal())
  }
}

